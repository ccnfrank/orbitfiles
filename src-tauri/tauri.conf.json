{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Files",
  "version": "0.8.0",
  "identifier": "com.ccnfrank.orbitfiles",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit Files",
        "width": 780,
        "height": 870,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Explore folders as points on a globe",
    "longDescription": "Orbit Files shows the subfolders and files of a folder as points on a rotating globe, with search, previews, thumbnails and audio waveforms.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
